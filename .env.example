# Local environment example for Laragon/MySQL or Aiven MySQL
ACTIVE_DRIVER=mysql

# Authentication
API_KEY=change_this_api_key
JWT_SECRET=change_this_jwt_secret
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
LOGIN_BLOCK_SECONDS=900

# Local MySQL (Laragon)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DBNAME=apiphp
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_AUTO_CREATE_DATABASE=1
MYSQL_INIT_SCHEMA=1
MYSQL_SEED_DEFAULT_USERS=1
MYSQL_SSL_MODE=
MYSQL_SSL_CA=
MYSQL_SSL_VERIFY_SERVER_CERT=1

# Example for Aiven MySQL (cloud)
# MYSQL_HOST=your-aiven-host.aivencloud.com
# MYSQL_PORT=3306
# MYSQL_DBNAME=defaultdb
# MYSQL_USER=avnadmin
# MYSQL_PASSWORD=your-password
# MYSQL_AUTO_CREATE_DATABASE=0
# MYSQL_INIT_SCHEMA=1
# MYSQL_SEED_DEFAULT_USERS=0
# MYSQL_SSL_MODE=verify_identity
# MYSQL_SSL_CA=/path/to/ca.pem
# MYSQL_SSL_VERIFY_SERVER_CERT=1

# Optional PostgreSQL fallback
PGSQL_HOST=127.0.0.1
PGSQL_PORT=5432
PGSQL_DBNAME=apiphp
PGSQL_USER=postgres
PGSQL_PASSWORD=postgres_password
